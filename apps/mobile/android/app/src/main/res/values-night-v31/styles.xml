<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows the system splash; keep it on brand so the
         hand-off to the Flutter splash has no white or black flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/michi_indigo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/michi_indigo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
