<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Temporary Debug/Profile signing for local device testing without APNs.
     Release continues to use Runner.entitlements. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.example.michiSudoku.daily</string>
    </array>
</dict>
</plist>
